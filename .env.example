# ==========================================
# 3D Cadastral Digital Registry - ENV Config
# ==========================================

# 1. Celery & Redis Configuration (Required)
# If using Render/Railway, they will provide this automatically if you attach a Redis instance.
# Locally, it defaults to redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# 2. Database Configuration (Supabase PostgreSQL / REST API)
# E.g., Supabase Project URL and Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key-here

# Or direct PostgreSQL connection string:
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres
# Or pooling: postgresql://postgres.[YOUR-SUPABASE-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres
# 3. LiDAR Data Fetching (Optional but recommended)
# Get a free API key from https://portal.opentopography.org/myopentopo
OPENTOPOGRAPHY_API_KEY=your_opentopo_api_key_here
# 4. CesiumJS 3D WebGL Engine (Optional but recommended)
# Get a free token from https://ion.cesium.com/ to remove the watermark and access global 3D terrain.
# You will need to inject this into your frontend HTML or JS.
CESIUM_ION_TOKEN=your_cesium_ion_token_here
