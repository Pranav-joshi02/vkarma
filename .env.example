# ===================================================================
# vKarma 3D Cadastral Digital Registry - Production & Free Cloud Config
# ===================================================================

# -------------------------------------------------------------------
# 1. Server & Cloud Host Ports
# -------------------------------------------------------------------
# Local default is 8000. On cloud platforms (Render, Koyeb, Railway),
# the platform automatically injects the PORT environment variable.
PORT=8000

# Public URL of your deployed application (used for Google Wallet pass callback,
# deep links, and CORS headers). Example: https://vkarma-3d-cadastre.onrender.com
PUBLIC_URL=http://localhost:8000

# -------------------------------------------------------------------
# 2. Redis & Asynchronous Worker (Optional)
# -------------------------------------------------------------------
# Option A (100% Free Cloud): Upstash Serverless Redis (10,000 commands/day free forever)
#   Sign up at: https://console.upstash.com/redis -> Create Database -> Copy 'rediss://...' URL
# Option B (Local Dev): redis://localhost:6379/0
# Option C (Zero-Setup Fallback): Leave commented or blank. vKarma includes an automatic,
#   built-in resilient ThreadPool worker that executes all 10 pipeline stages asynchronously
#   without requiring Redis or Celery!
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------------
# 3. 3D WebGL Visualization (Cesium Ion)
# -------------------------------------------------------------------
# Free Community account (5GB 3D asset storage & 75GB/month streaming)
# Get your free token at: https://ion.cesium.com/tokens
CESIUM_ION_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJub25jZSI6IjYybXUwUk5Jejg5NUc5MDAiLCJqdGkiOiI0MzllNTI0YS1hNmIyLTQ0M2MtYjk1OS0yMTY0OWQ0ZjY3NjIiLCJpZCI6NTAwMzU3LCJzdWIiOiIyNDA3MDU3OSIsImlzcyI6Imh0dHBzOi8vYXBpLmNlc2l1bS5jb20iLCJhdWQiOiJ2S2FybWEiLCJpYXQiOjE3ODk3NTg0Mzl9.y2ZVklxqJOT0Jf4ZRbbvXBygLHLuDEhyp60Cb-UcAEw

# -------------------------------------------------------------------
# 4. LiDAR Aerial Survey Ingestion (OpenTopography)
# -------------------------------------------------------------------
# Free API key for high-density USGS 3DEP & global point cloud downloads
# Get free key at: https://portal.opentopography.org/myopentopo
OPENTOPOGRAPHY_API_KEY=ee986f7304c354a52947e7b1c7a7cacf

# -------------------------------------------------------------------
# 5. Persistent Spatial Cadastre Database (Supabase PostgreSQL)
# -------------------------------------------------------------------
# Free Tier: 500 MB database, unlimited API requests, PostGIS extension
# Sign up at: https://supabase.com -> Create Project -> Project Settings -> API / Database
# REST API (Project URL & Anon / Service Role Key):
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key

# Direct PostgreSQL connection string (Supabase IPv4 Pooler):
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# -------------------------------------------------------------------
# 6. DigiLocker Government Land Document Gateway (MeitY / DILRMP)
# -------------------------------------------------------------------
# Keep DIGILOCKER_SANDBOX_MODE=true for testing without government credentials.
# Set to 'false' only with live registered MeitY issuer credentials.
DIGILOCKER_SANDBOX_MODE=true
DIGILOCKER_ISSUER_ID=in.gov.dilrmp
DIGILOCKER_ISSUER_NAME=Department of Land Resources (DoLR), Ministry of Rural Development, Govt of India
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_GATEWAY_URL=https://api.digitallocker.gov.in/public/oauth2/1/token

# -------------------------------------------------------------------
# 7. Transactional Email Gateway (Brevo / Sendinblue)
# -------------------------------------------------------------------
# Free tier gives 300 free emails per day forever.
# Sign up at: https://app.brevo.com -> SMTP & API -> Create API Key
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-verified-email@domain.com
BREVO_SENDER_NAME=vKarma 3D Cadastre

# -------------------------------------------------------------------
# 8. Google Wallet Digital Land Pass API (100% Free on Google Cloud)
# -------------------------------------------------------------------
# 1. Google Pay & Wallet Console: https://pay.google.com/business/console
# 2. Google Cloud Service Account with "Google Wallet Object Issuer" role
GOOGLE_WALLET_ISSUER_ID=3388000000022345678
GOOGLE_WALLET_SA_EMAIL=vkarma-wallet@vkarma-cadastre.iam.gserviceaccount.com

# Supply ONE of the following for authentication:
# A) Paste the private key PEM directly:
GOOGLE_WALLET_PRIVATE_KEY=

# B) Or paste the ENTIRE service account JSON string (ideal for cloud platforms):
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# C) Or relative / absolute path to service account json key file:
GOOGLE_WALLET_KEY_FILE=vkarma-wallet-d0c9502a0925.json